# ===== Local por defecto: DEMO sin servicios externos (cuentas y talleres en memoria) =====
HOBBIZ_MODE=demo
PORT=3001

# ===== Modo real: Firebase Authentication + MongoDB Atlas =====
# HOBBIZ_MODE=firebase-mongo
# Cadena de "Connect > Drivers" del clúster. Deja <db_password> tal cual y pon la clave en MONGODB_PASSWORD.
# NUNCA subas el archivo .env real a Git.
# MONGODB_URI=mongodb+srv://USUARIO:<db_password>@hobbiz-demo.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=hobbiz-demo
# MONGODB_PASSWORD=coloca-tu-contrasena-localmente
# Usa otra base para desarrollo local (p. ej. hobbiz-dev): el servidor publicado y tu PC no deben compartir la misma.
# MONGODB_DB=hobbiz-dev
# false = no inserta fichas al arrancar; cárgalas una vez con:  npm run db:seed  (o --dry-run para simular)
# MONGODB_SEED_CATALOG=false
# FIREBASE_PROJECT_ID=hobbiz-597c5
# Cuenta de servicio de Firebase (elige UNA):
#   local: copia el JSON en backend/credentials/
#   nube:  FIREBASE_SERVICE_ACCOUNT_BASE64=<salida de: base64 -w0 cuenta-servicio.json>
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Correos del equipo que aprueban talleristas y leen el formulario de opinión (separados por comas).
# ADMIN_EMAILS=equipo@hobbiz.pe,otra-persona@correo.pe

# ===== Solo en producción (Render u otro hosting) =====
# NODE_ENV=production          → escucha en 0.0.0.0, exige firebase-mongo y CORS_ORIGIN
# CORS_ORIGIN=https://hobbiz.vercel.app,https://hobbiz-597c5.web.app
# TRUST_PROXY=1                → detrás del proxy de Render (IP real para los límites de intentos)
# HOST=0.0.0.0                 → por defecto en producción
# PUBLIC_API_URL=https://hobbiz-api.onrender.com   (opcional: URL pública para armar enlaces de imágenes)
# RATE_LIMIT=off               → solo para pruebas; desactiva los límites de intentos
