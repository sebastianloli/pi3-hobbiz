# Predeterminado: DEMO sin servicios externos, cuentas y talleres en memoria.
HOBBIZ_MODE=demo
PORT=3001

# ===== Modo real: Firebase Authentication + MongoDB Atlas =====
# HOBBIZ_MODE=firebase-mongo
# Cadena de "Connect > Drivers" del clúster hobbiz-demo; deja <db_password> y pon la clave abajo.
# MONGODB_URI=mongodb+srv://USUARIO:<db_password>@hobbiz-demo.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=hobbiz-demo
# MONGODB_PASSWORD=coloca-tu-contrasena-localmente
# MONGODB_DB=hobbiz
# true = al arrancar inserta las 24 fichas reales que falten (no pisa lo editado).
# MONGODB_SEED_CATALOG=true
# FIREBASE_PROJECT_ID=hobbiz-597c5
# Cuenta de servicio: copia el JSON en backend/credentials/ (recomendado) o indica su ruta:
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/segura/firebase-service-account.json
# CORS_ORIGIN=http://localhost:5173
